<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude health databases, sensitive documents, and auth prefs from cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="documents" />
        <exclude domain="sharedpref" path="health_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfers are allowed for migration -->
        <include domain="database" path="." />
        <include domain="file" path="documents" />
    </device-transfer>
</data-extraction-rules>
